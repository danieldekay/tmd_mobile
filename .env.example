# TMD Core API base. Override for local WordPress development when needed.
PUBLIC_TMD_API_BASE_URL=https://www.tangomarathons.com/wp-json/tmd/v3

# Optional analytics placeholders. Keep secrets out of PUBLIC_* variables.
PUBLIC_MATOMO_URL=
PUBLIC_MATOMO_SITE_ID=

# Enable server-sync features: JWT auth + server-side saved-events.
# Off by default (production uses localStorage-only for guests).
# Set to "true" in .env.development to test authentication locally.
VITE_ENABLE_SERVER_SYNC=false
